# CONFIGURACIÓN DEL SERVIDOR Y ENTORNO
# ============================================================
PORT=3000
NODE_ENV=development
CUIT=cuit_para_script

# BASE DE DATOS MONGODB
# ============================================================
# Para desarrollo local con MongoDB local:
MONGODB_URI=mongodb://localhost:27017/hermanos_jota
# O para MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/hermanos_jota?retryWrites=true&w=majority

# SEGURIDAD Y AUTENTICACIÓN (JWT)
# ============================================================
JWT_SECRET=super_secreto_para_desarrollo_hermanos_jota_2026

# INTEGRACIÓN FRONTEND & CORS
# ============================================================
FRONTEND_URL=http://localhost:5173

# GOOGLE OAUTH 2.0 (PASSPORT) - Opcional en desarrollo local
# ============================================================
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback


# SERVICIOS TERCEROS (Mercado Pago, Cloudinary)
# ============================================================
CLOUDINARY_CLOUD_NAME=clave
CLOUDINARY_API_KEY=clave_numérica
CLOUDINARY_API_SECRET=clave_secreta

MP_PUBLIC_KEY=clave_pública_mp
MP_ACCESS_TOKEN=access_token_mp
AFIP_ACCESS_TOKEN=clave_larga_afip/sdk

RESEND_KEY=clave_de_resend_mails
